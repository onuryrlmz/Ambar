{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambar",
  "version": "0.1.0",
  "identifier": "com.onuryrlmz.ambar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ambar",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Arşiv yöneticisi",
    "category": "Utility",
    "publisher": "onuryrlmz",
    "copyright": "© 2026 onuryrlmz. Tüm hakları saklıdır.",
    "macOS": { "signingIdentity": "-" }
  }
}
